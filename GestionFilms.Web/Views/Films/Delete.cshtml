@model GestionFilms.Web.Models.Film

@{
    ViewData["Title"] = "Supprimer un film";
}

<section class="delete-cinema-shell mx-auto">
    <div class="delete-cinema-card">
        <div class="delete-cinema-head">
            <h2>Supprimer ce film ?</h2>
            <p>Cette action est définitive.</p>
        </div>

        <dl class="delete-cinema-details mb-0">
            <div>
                <dt>@Html.DisplayNameFor(model => model.Titre)</dt>
                <dd>@Html.DisplayFor(model => model.Titre)</dd>
            </div>

            <div>
                <dt>@Html.DisplayNameFor(model => model.Realisateur)</dt>
                <dd>@Html.DisplayFor(model => model.Realisateur)</dd>
            </div>

            <div>
                <dt>@Html.DisplayNameFor(model => model.AnneeSortie)</dt>
                <dd>@Html.DisplayFor(model => model.AnneeSortie)</dd>
            </div>
        </dl>

        <form asp-action="Delete" class="delete-cinema-actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger fw-semibold">Supprimer</button>
            <a asp-action="Index" class="btn btn-ghost">Annuler</a>
        </form>
    </div>
</section>
